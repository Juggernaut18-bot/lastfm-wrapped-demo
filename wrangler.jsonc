{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "lastfm-wrapped-demo",
  "main": "./worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
